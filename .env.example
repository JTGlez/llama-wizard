# .env.example — tracked template
#
# Copy this file to `.env` (which is gitignored) and edit as needed.
#
#   cp .env.example .env
#   $EDITOR .env
#
# This file is mounted into the `llm-server` container via `env_file:`
# in docker-compose.yml. Variables defined here are passed to llama-server.

# GPU selection inside the container. `0` = first GPU visible to the
# nvidia runtime. Set to `0,1` to expose both, or `1` for the second only.
# This overrides the `CUDA_VISIBLE_DEVICES` value in docker-compose.yml
# when both are present.
# CUDA_VISIBLE_DEVICES=0
